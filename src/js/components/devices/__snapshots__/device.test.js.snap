  .emotion-62 {
    -webkit-print-color-adjust: exact;
    color-adjust: exact;
  }
}

.emotion-62:hover {
  -webkit-text-decoration: none;
  text-decoration: none;
  background-color: rgba(20, 164, 82, 0.04);
}

@media (hover: none) {
  .emotion-62:hover {
    background-color: transparent;
  }
}

.emotion-62.Mui-disabled {
  color: rgba(0, 0, 0, 0.26);
}

.emotion-62:hover {
  colors: #14A452;
}

.emotion-62.MuiButton-text {
  color: #212121;
}

.emotion-62:hover {
  background: #F5F5F5;
}

.emotion-63 {
  display: inherit;
  margin-right: -2px;
  margin-left: 8px;
}

.emotion-63>*:nth-of-type(1) {
  font-size: 18px;
}

